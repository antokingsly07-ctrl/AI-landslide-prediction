# Public Vite env vars (must be prefixed with VITE_)
# Local dev: leave empty to use the Vite proxy (/api -> 127.0.0.1:8000)
# Production on Vercel: set to your deployed backend, e.g.
# VITE_API_URL=https://landslide-backend.vercel.app/api/v1
VITE_API_URL=

# WebSocket endpoint for real-time alerts (defaults to same-origin /ws/alerts)
# VITE_WS_URL=ws://127.0.0.1:8000