{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/(.*)", "dest": "https://ai-landslide-prediction-n4kk.onrender.com/api/$1" },
    { "src": "^/media/(.*)", "dest": "https://ai-landslide-prediction-n4kk.onrender.com/media/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}