# ------------------------------------------------------------------
# Environment configuration for the AI Landslide Early Warning Platform
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Database ---
# Production: PostgreSQL + PostGIS
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/landslide
# Development fallback (SQLite) - used when Postgres/PostGIS is unavailable locally
DATABASE_URL=sqlite:///./landslide_dev.db

# --- Security ---
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App ---
APP_NAME=Landslide Early Warning and Monitoring Platform
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- External Data Providers (leave blank to use mock providers) ---
# Live weather:
#   WEATHER_PROVIDER=auto    # auto = OpenWeatherMap if key set, else WeatherAPI.com if key set, else IMD if set, else Open-Meteo (free, no key)
#   WEATHER_PROVIDER=openmeteo | openweather | weatherapi | imd | mock
WEATHER_PROVIDER=auto
OPENWEATHER_API_KEY=        # get free key at https://openweathermap.org/api
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# WeatherAPI.com - free key (no card) at https://www.weatherapi.com/signup.aspx
WEATHERAPI_API_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# IMD official portal: register at https://api.imd.gov.in -> generate API key / JWT
IMD_API_KEY=
IMD_API_TOKEN=              # optional pre-generated JWT bearer token (overrides key)
IMD_TOKEN_URL=              # optional key->JWT token endpoint if issued by the portal
IMD_BASE_URL=https://api.imd.gov.in
IMD_STATE_ID=24             # AWS/ARG state id (24=Assam; 6=Meghalaya, 14=Mizoram, 28=Arunachal)
IMD_STATION_ID=             # optional station id for /api/v1/current_wx fallback

SATELLITE_API_KEY=
# Satellite: real Sentinel-2 coverage via Planetary Computer STAC catalog (keyless)
#   SATELLITE_SOURCE=auto | stac | mock
SATELLITE_SOURCE=auto
SATELLITE_BASE_URL=https://planetarycomputer.microsoft.com/api/stac/v1/search

TERRAIN_BASE_URL=https://api.open-meteo.com/v1/elevation  # keyless SRTM elevation
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point  # keyless MERRA-2 reanalysis

# --- Notifications (real delivery requires your provider account) ---
# Fast2SMS (India) - register at https://www.fast2sms.com -> get API key
SMS_PROVIDER=mock                # mock | fast2sms
FAST2SMS_API_KEY=
SMS_SENDER_ID=
SMS_ROUTE=qtp
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# --- Bootstrap super admin (created on first boot when the users table is empty) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Object Storage (production) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
# Local storage fallback directory
LOCAL_STORAGE_DIR=./storage/media
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/media

# --- ML Model ---
# Path to the trained model artifact relative to backend/
ML_MODEL_PATH=./ml_artifacts/model.joblib

# --- Monitoring ---
POLL_INTERVAL_SECONDS=300      # real-time risk monitoring interval
ALERT_COOLDOWN_MINUTES=60

# --- News automation (auto-incidents from news channels under 24h) ---
# Providers are keyless: google_rss (Google News RSS) and gdelt (GDELT DOC API).
# auto = try google_rss, fall back to gdelt. mock = disable ingestion.
NEWS_ENABLED=true
NEWS_PROVIDER=auto
NEWS_QUERY=landslide OR landslip OR mudslide india
NEWS_TIMESPAN_HOURS=24
NEWS_MAX_RECORDS=50

# --- Risk Thresholds (overridable at runtime via Admin -> Risk Thresholds) ---
# Defaults are stored in DB (system_config). Format per level: [lower, upper]
# RISK_THRESHOLDS={"VERY_LOW":[0,20],"LOW":[21,40],"MODERATE":[41,60],"HIGH":[61,80],"CRITICAL":[81,100]}

# --- Realtime (WebSocket) ---
# Browser auto-connects to /ws/alerts on the same origin; override for custom gateway:
# VITE_WS_URL=ws://127.0.0.1:8000

# --- Registration ---
# Self-registration is limited to citizen / field_official roles.
