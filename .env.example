# ------------------------------------------------------------------
# Environment configuration for the AI Landslide Early Warning Platform
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Database ---
# Production: PostgreSQL + PostGIS
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/landslide
# Development fallback (SQLite) - used when Postgres/PostGIS is unavailable locally
DATABASE_URL=sqlite:///./landslide_dev.db

# --- Security ---
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App ---
APP_NAME=Landslide Early Warning and Monitoring Platform
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- External Data Providers (leave blank to use mock providers) ---
# Live weather:
#   WEATHER_PROVIDER=auto    # auto = OpenWeatherMap if key set, else IMD if set, else Open-Meteo (free, no key)
#   WEATHER_PROVIDER=openmeteo | openweather | imd | mock
WEATHER_PROVIDER=auto
OPENWEATHER_API_KEY=        # get free key at https://openweathermap.org/api
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

IMD_API_KEY=
IMD_BASE_URL=

SATELLITE_API_KEY=
SATELLITE_BASE_URL=

TERRAIN_API_KEY=
TERRAIN_BASE_URL=

# --- Notifications ---
SMS_API_KEY=
SMS_PROVIDER=             # twilio | vodafone | mock
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# --- Object Storage (production) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
# Local storage fallback directory
LOCAL_STORAGE_DIR=./storage/media
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/media

# --- ML Model ---
# Path to the trained model artifact relative to backend/
ML_MODEL_PATH=./ml_artifacts/model.joblib

# --- Monitoring ---
POLL_INTERVAL_SECONDS=300      # real-time risk monitoring interval
ALERT_COOLDOWN_MINUTES=60

# --- Risk Thresholds (overridable at runtime via Admin -> Risk Thresholds) ---
# Defaults are stored in DB (system_config). Format per level: [lower, upper]
# RISK_THRESHOLDS={"VERY_LOW":[0,20],"LOW":[21,40],"MODERATE":[41,60],"HIGH":[61,80],"CRITICAL":[81,100]}

# --- Realtime (WebSocket) ---
# Browser auto-connects to /ws/alerts on the same origin; override for custom gateway:
# VITE_WS_URL=ws://127.0.0.1:8000

# --- Registration ---
# Self-registration is limited to citizen / field_official roles.
