# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data / local databases
backend/storage/
*.db
*.sqlite
*.sqlite3
*.db-journal

# Logs / secrets
*.log
.env
.env.*
!.env.example

# VCS / IDE
.git/
.vscode/
.idea/
Thumbs.db